{
  "name": "char",
  "productName": "char",
  "version": "1.2.0",
  "private": true,
  "description": "The AI notepad that gets things done. Local-first, open source, for macOS.",
  "author": "Jay Katariya",
  "license": "MIT",
  "repository": "github:jayamitkatariya/char",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "rm -rf .next out && next build",
    "lint": "eslint",
    "app:serve": "CHAR_TARGET=app next dev -p 3210",
    "app:dev": "CHAR_DEV_URL=http://localhost:3210 electron .",
    "app:start": "npm run app:build && electron .",
    "app:dist": "npm run app:build && electron-builder --mac",
    "app:build": "rm -rf .next out && CHAR_TARGET=app next build",
    "app:dist:adhoc": "npm run app:build && electron-builder --mac -c.mac.identity=- -c.mac.hardenedRuntime=false"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "next": "16.4.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.jaykatariya.char",
    "productName": "char",
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "12.0"
    },
    "protocols": [
      {
        "name": "char note link",
        "schemes": [
          "char"
        ]
      }
    ],
    "artifactName": "${productName}-${arch}.${ext}",
    "dmg": {
      "title": "char",
      "contents": [
        {
          "x": 150,
          "y": 190
        },
        {
          "x": 410,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "extraResources": [
      {
        "from": "electron/cli.js",
        "to": "cli.js"
      },
      {
        "from": "electron/cliSocket.js",
        "to": "cliSocket.js"
      }
    ]
  }
}
